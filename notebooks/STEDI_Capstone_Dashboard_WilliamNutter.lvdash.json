{
  "datasets": [
    {
      "name": "bf238443",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "----2.1.a Total Records\r\n",
        "SELECT COUNT(*) AS total_records\r\n",
        "FROM workspace.silver.labeled_step_test_sampled;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "f2e84c6f",
      "displayName": "labeled_step_test_sampled",
      "queryLines": [
        "---2.1b\r\n",
        "SELECT \r\n",
        "  CASE \r\n",
        "    WHEN total_steps > 0 THEN 1 \r\n",
        "    ELSE 0 \r\n",
        "  END AS step_label,\r\n",
        "  COUNT(*) AS count\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY 1;"
      ]
    },
    {
      "name": "39577d46",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "----2.1.c Label Distribution (Derived)\r\n",
        "SELECT 'Min Distance' AS metric, MIN(distance_cm) AS value\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT 'Max Distance' AS metric, MAX(distance_cm) AS value\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT 'Average Distance' AS metric, AVG(distance_cm) AS value\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT 'Std Dev Distance' AS metric, STDDEV(distance_cm) AS value\r\n",
        "FROM workspace.silver.labeled_step_test_sampled;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "bdd20929",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "---2.2.a Readings Over Time\r\n",
        "SELECT \r\n",
        "  device_id,\r\n",
        "  COUNT(*) AS reading_count\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "GROUP BY device_id\r\n",
        "ORDER BY reading_count DESC;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "55bc6eab",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "---2.2.b Steps Over Time\r\n",
        "SELECT \r\n",
        "  timestamp AS date,\r\n",
        "  COUNT(*) AS reading_count\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "GROUP BY timestamp\r\n",
        "ORDER BY timestamp;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "1dae6e82",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "---2.3 Accuracy\r\n",
        "WITH base AS (\r\n",
        "  SELECT\r\n",
        "    SUM(CASE WHEN actual_label = predicted_label THEN 1 ELSE 0 END) AS correct,\r\n",
        "    COUNT(*) AS total,\r\n",
        "    SUM(CASE WHEN actual_label = 1 AND predicted_label = 1 THEN 1 ELSE 0 END) AS tp,\r\n",
        "    SUM(CASE WHEN predicted_label = 1 THEN 1 ELSE 0 END) AS predicted_positive,\r\n",
        "    SUM(CASE WHEN actual_label = 1 THEN 1 ELSE 0 END) AS actual_positive\r\n",
        "  FROM workspace.analytics.stedi_predictions_capstone\r\n",
        ")\r\n",
        "\r\n",
        "SELECT 'Accuracy' AS metric_name, correct / total AS value FROM base\r\n",
        "UNION ALL\r\n",
        "SELECT 'Precision', tp / predicted_positive FROM base\r\n",
        "UNION ALL\r\n",
        "SELECT 'Recall', tp / actual_positive FROM base\r\n",
        "UNION ALL\r\n",
        "SELECT 'F1 Score',\r\n",
        "  2 * (tp / predicted_positive) * (tp / actual_positive)\r\n",
        "  /\r\n",
        "  ((tp / predicted_positive) + (tp / actual_positive))\r\n",
        "FROM base;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "cb1aba64",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "----SECTION 2.4 — Confusion Matrix\r\n",
        "SELECT \r\n",
        "  actual_label,\r\n",
        "  predicted_label,\r\n",
        "  COUNT(*) AS count\r\n",
        "FROM workspace.analytics.stedi_predictions_capstone\r\n",
        "GROUP BY actual_label, predicted_label\r\n",
        "ORDER BY actual_label, predicted_label;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "786719f3",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "---SECTION 2.5 — Feature Importance\r\n",
        "SELECT\r\n",
        "  CASE WHEN total_steps > 0 THEN 1 ELSE 0 END AS step_label,\r\n",
        "  AVG(distance_cm) AS avg_distance,\r\n",
        "  AVG(test_time) AS avg_test_time,\r\n",
        "  AVG(total_steps) AS avg_total_steps\r\n",
        "FROM workspace.silver.labeled_step_test_sampled\r\n",
        "GROUP BY step_label;"
      ]
    },
    {
      "name": "f0812008",
      "displayName": "stedi_feature_importance",
      "queryLines": [
        "SELECT * FROM workspace.analytics.stedi_feature_importance"
      ]
    },
    {
      "name": "a1a578e3",
      "displayName": "stedi_predictions_capstone",
      "queryLines": [
        "---SECTION 2.6 — Bias / Fairness Discussion\r\n",
        "SELECT\r\n",
        "  SUM(CASE WHEN actual_label != predicted_label THEN 1 ELSE 0 END) \r\n",
        "  / COUNT(*) AS error_rate\r\n",
        "FROM workspace.analytics.stedi_predictions_capstone;"
      ],
      "catalog": "workspace",
      "schema": "analytics"
    },
    {
      "name": "d935fd54",
      "displayName": "stedi_step_curated",
      "queryLines": [
        "SELECT * FROM workspace.silver.stedi_step_curated"
      ]
    }
  ],
